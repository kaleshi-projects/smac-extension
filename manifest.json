{
    "manifest_version": 3,
    "name": "SMAC Extension",
    "version": "2.0.0",
    "icons": {
        "16": "icon.jpg",
        "48": "icon.jpg",
        "128": "icon.jpg"
    },
    "permissions": [
        "storage",
        "clipboardWrite",
        "tabs"
    ],
    "host_permissions": [
        "http://localhost:11434/*",
        "https://*/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://*.twimg.com/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://*.licdn.com/*"
    ],
    "background": {
        "service_worker": "src/background/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://twitter.com/*",
                "https://*.twitter.com/*",
                "https://x.com/*",
                "https://*.x.com/*",
                "https://linkedin.com/*",
                "https://*.linkedin.com/*"
            ],
            "js": [
                "src/content/index.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*.js",
                "assets/*.css",
                "src/utils/injected.js",
                "src/content/modal.js"
            ],
            "matches": [
                "https://www.linkedin.com/*",
                "https://linkedin.com/*",
                "https://*.linkedin.com/*",
                "https://x.com/*",
                "https://*.x.com/*",
                "https://*.twitter.com/*"
            ]
        }
    ],
    "action": {
        "default_popup": "index.html"
    }
}
