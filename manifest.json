{
    "manifest_version": 3,
    "name": "SMAC Extension",
    "version": "1.0.0",
    "permissions": [
        "storage",
        "clipboardWrite"
    ],
    "host_permissions": [
        "http://localhost:11434/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.twimg.com/*",
        "https://*.linkedin.com/*",
        "https://*.licdn.com/*"
    ],
    "background": {
        "service_worker": "src/background/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.twitter.com/*",
                "*://*.x.com/*",
                "*://*.linkedin.com/*"
            ],
            "js": [
                "src/content/index.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/utils/injected.js"
            ],
            "matches": [
                "*://*.twitter.com/*",
                "*://*.x.com/*",
                "*://*.linkedin.com/*"
            ]
        }
    ],
    "action": {
        "default_popup": "index.html"
    }
}