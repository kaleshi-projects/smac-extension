{
    "manifest_version": 3,
    "name": "SMAC Extension",
    "version": "1.0.0",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "http://localhost:11434/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.twimg.com/*"
    ],
    "background": {
        "service_worker": "src/background/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.twitter.com/*",
                "*://*.x.com/*"
            ],
            "js": [
                "src/content/index.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "index.html"
    }
}